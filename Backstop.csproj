<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF><UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <Version>1.7.0</Version>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
  <Product>Backstop</Product><Title>Backstop</Title><Company>informent</Company></PropertyGroup>
  <ItemGroup>
    <Compile Include="App.xaml.cs;MainWindow.xaml.cs;BackupEngine.cs;SnapshotAnalysis.cs;AnalysisCommand.cs;ScheduleEngine.cs;ProfileStore.cs;ScheduledRunner.cs;TaskSchedulerService.cs;RetentionEngine.cs;ActivityLog.cs" />
    <ApplicationDefinition Include="App.xaml" /><Page Include="MainWindow.xaml" />
  </ItemGroup>
</Project>
