<Window x:Class="Backstop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Backstop" Width="1240" Height="820" MinWidth="1080" MinHeight="700" Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen">
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="218"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Background="#172536"><Grid Margin="22,28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="BACKSTOP" Foreground="#89B8EA" FontSize="12" FontWeight="Bold"/><TextBlock Text="Your files.\nUnder your control." Foreground="White" FontSize="22" FontWeight="SemiBold" Margin="0,10,0,0"/><Border Background="#253B53" CornerRadius="5" Padding="8,5" Margin="0,20,0,0" HorizontalAlignment="Left"><TextBlock Text="LOCAL-FIRST" Foreground="#BBD6EF" FontSize="10" FontWeight="Bold"/></Border></StackPanel><StackPanel Grid.Row="1" Margin="0,54,0,0"><TextBlock Text="WORKSPACE" Foreground="#7890A7" FontSize="10" FontWeight="Bold" Margin="8,0,0,12"/><Border Background="#2B4F76" CornerRadius="7" Padding="11,10"><StackPanel Orientation="Horizontal"><TextBlock Text="▦" Foreground="White" FontSize="16"/><TextBlock Text="  Overview" Foreground="White" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel></Border><StackPanel Orientation="Horizontal" Margin="12,20,0,0"><TextBlock Text="◷" Foreground="#9CB0C3" FontSize="16"/><TextBlock Text="  Schedules" Foreground="#C0CDDA" FontSize="13" VerticalAlignment="Center"/></StackPanel><StackPanel Orientation="Horizontal" Margin="12,20,0,0"><TextBlock Text="✓" Foreground="#9CB0C3" FontSize="16"/><TextBlock Text="  Verification" Foreground="#C0CDDA" FontSize="13" VerticalAlignment="Center"/></StackPanel></StackPanel><StackPanel Grid.Row="2"><Separator Background="#34485D" Margin="0,0,0,15"/><TextBlock Text="Backstop 1.5.1" Foreground="#9CB0C3" FontSize="11"/><TextBlock Text="MIT licensed · no telemetry" Foreground="#71869A" FontSize="10" Margin="0,5,0,0"/></StackPanel></Grid></Border>
<Grid Grid.Column="1" Margin="38,30,42,28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><StackPanel><TextBlock Text="Overview" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="A quiet, dependable place for your snapshots." Foreground="{StaticResource Muted}" FontSize="14" Margin="0,5,0,0"/></StackPanel><StackPanel HorizontalAlignment="Right" Orientation="Horizontal"><Border Background="#E8F3EC" CornerRadius="15" Padding="11,6" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="#2D7858" Margin="0,0,7,0"/><TextBlock Text="LOCAL &amp; PRIVATE" Foreground="#2D7858" FontSize="10" FontWeight="Bold"/></StackPanel></Border></StackPanel></Grid>
<Border Grid.Row="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,26,0,22"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="ACTIVE BACKUP PROFILE" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="ProfileName" Text="No profile configured" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,0"/><TextBlock x:Name="ProfilePath" Text="Choose a source and destination to begin." Foreground="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="Choose source" Click="ChooseSource_Click"/><Button Content="Choose destination" Click="ChooseDestination_Click"/><Button Content="Create snapshot" Click="CreateSnapshot_Click" Background="{StaticResource Accent}" Foreground="White"/></StackPanel></Grid></Border>
<Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="9" Padding="17" Margin="0,0,10,0"><StackPanel><TextBlock Text="CURRENT STATUS" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="StatusText" Text="Ready" FontSize="20" FontWeight="SemiBold" Margin="0,7,0,0"/><TextBlock Text="System is standing by" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0"/></StackPanel></Border><Border Grid.Column="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="9" Padding="17" Margin="5,0"><StackPanel><TextBlock Text="LATEST SNAPSHOT" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="LatestText" Text=":" FontSize="20" FontWeight="SemiBold" Margin="0,7,0,0"/><TextBlock Text="Most recent version" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0"/></StackPanel></Border><Border Grid.Column="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="9" Padding="17" Margin="10,0,0,0"><StackPanel><TextBlock Text="FILES PROTECTED" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="FileCountText" Text=":" FontSize="20" FontWeight="SemiBold" Margin="0,7,0,0"/><TextBlock Text="In the latest snapshot" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0"/></StackPanel></Border></Grid>
<Grid Grid.Row="1" Margin="0,22,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="1.12*"/><ColumnDefinition Width="0.88*"/></Grid.ColumnDefinitions><Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,0,10,0"><StackPanel><Grid><StackPanel><TextBlock Text="SNAPSHOT HISTORY" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="Bold"/><TextBlock Text="Choose a version to inspect or restore" FontSize="16" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel><TextBlock Text="ALL VERSIONS" HorizontalAlignment="Right" VerticalAlignment="Bottom" Foreground="{StaticResource Accent}" FontSize="10" FontWeight="Bold"/></Grid><ListBox x:Name="SnapshotList" Height="255" Margin="0,17,0,0" Background="Transparent" BorderThickness="0" SelectionChanged="SnapshotList_SelectionChanged"/></StackPanel></Border><StackPanel Grid.Column="1" Margin="10,0,0,0"><Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="20"><StackPanel><TextBlock Text="SELECTED SNAPSHOT" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="SelectedText" Text="Nothing selected" FontSize="17" FontWeight="SemiBold" Margin="0,7,0,16"/><TextBlock x:Name="VerificationText" Text="Choose a snapshot to preview its manifest." TextWrapping="Wrap" Foreground="{StaticResource Muted}"/><StackPanel Orientation="Horizontal" Margin="0,20,0,0"><Button Content="Verify" Click="VerifySnapshot_Click"/><Button Content="Restore" Click="RestoreSnapshot_Click"/></StackPanel></StackPanel></Border><Border Background="#F8FAFC" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,14,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="SCHEDULE" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="Bold"/><TextBlock Text="Automatic snapshots" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,0"/><TextBlock x:Name="NextRunText" Text="Not scheduled" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0"/></StackPanel><StackPanel Grid.Column="1" VerticalAlignment="Center"><CheckBox x:Name="ScheduleEnabled" Content="Enabled" Checked="ScheduleChanged" Unchecked="ScheduleChanged" Margin="0,0,0,8"/><ComboBox x:Name="ScheduleInterval" Width="130" SelectionChanged="ScheduleChanged"><ComboBoxItem Content="Every hour" Tag="1"/><ComboBoxItem Content="Every 6 hours" Tag="6"/><ComboBoxItem Content="Every day" Tag="24"/><ComboBoxItem Content="Every week" Tag="168"/></ComboBox></StackPanel></Grid></Border></StackPanel></Grid></Grid></Grid></Grid>
</Window>
